#!/usr/bin/env python3
"""claude-lifecycle — install/uninstall the Claude Code hooks, verify, status. CONTRACT.md §4."""
import json, os, shutil, subprocess, sys, tempfile, time, glob
HERE=os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HOOK=os.path.join(HERE,"hooks","claude-lifecycle.py")
EVENTS=["SessionStart","UserPromptSubmit","PreToolUse","PostToolUse","PostToolUseFailure","PermissionRequest",
        "Notification","Elicitation","ElicitationResult","Stop","SubagentStop","TaskCompleted","PreCompact","SessionEnd"]
NO_MATCHER={"UserPromptSubmit","Stop","TaskCompleted"}          # hooks.md: no matcher support
ASYNC={"PreToolUse","PostToolUse","PostToolUseFailure","PreCompact"}  # high-frequency "working" events: off the critical path (hooks.md §async)
SETTINGS=os.environ.get("CLAUDE_LIFECYCLE_SETTINGS") or os.path.join(os.environ.get("CLAUDE_CONFIG_DIR",os.path.expanduser("~/.claude")),"settings.json")
STATE_ROOT=os.path.join(os.environ.get("XDG_STATE_HOME",os.path.expanduser("~/.local/state")),"omarchy","claude-lifecycle")
MARK="claude-lifecycle.py"
VSTAMP=os.path.join(STATE_ROOT,"claude_version")
def claude_version():
    try: return subprocess.run(["claude","--version"],capture_output=True,text=True,timeout=20).stdout.strip()
    except Exception: return ""
def stamp_version():
    v=claude_version(); os.makedirs(STATE_ROOT,exist_ok=True); open(VSTAMP,"w").write(v+"\n"); return v
def load():
    try: return json.load(open(SETTINGS))
    except FileNotFoundError: return {}
def save(d):
    os.makedirs(os.path.dirname(SETTINGS),exist_ok=True)
    if os.path.exists(SETTINGS): shutil.copy2(SETTINGS,SETTINGS+f".bak-claude-lifecycle-{int(time.time())}")
    tmp=SETTINGS+".tmp"; json.dump(d,open(tmp,"w"),indent=2); open(tmp,"a").write("\n"); os.replace(tmp,SETTINGS)
def entry(ev, hook=None):
    h={"type":"command","command":"python3","args":[hook or HOOK],"timeout":10}   # exec form: no sh -c, no quoting
    if ev in ASYNC: h["async"]=True
    e={"hooks":[h]}
    if ev not in NO_MATCHER: e["matcher"]="*"
    return e
def hooks_block(hook=None): return {ev:[entry(ev,hook)] for ev in EVENTS}
def ours(grp): return any(MARK in ((h.get("command") or "")+" ".join(h.get("args") or [])) for h in grp.get("hooks",[]))
def install_hooks():
    d=load(); hooks=d.setdefault("hooks",{})
    for ev in EVENTS:
        arr=hooks.setdefault(ev,[]); arr[:]=[g for g in arr if not ours(g)]; arr.append(entry(ev))
    save(d); v=stamp_version(); print(f"installed {len(EVENTS)} hook wirings → {SETTINGS}  (claude {v or '?'})")
def uninstall_hooks():
    d=load(); hooks=d.get("hooks",{}); n=0
    for ev in list(hooks):
        before=len(hooks[ev]); hooks[ev]=[g for g in hooks[ev] if not ours(g)]; n+=before-len(hooks[ev])
        if not hooks[ev]: del hooks[ev]
    save(d); print(f"removed {n} hook wirings from {SETTINGS}")
def wiring_ok():
    hooks=load().get("hooks",{}); missing=[ev for ev in EVENTS if not any(ours(g) for g in hooks.get(ev,[]))]
    return missing
def run_fixture(path):
    payload=open(path).read(); ev=json.loads(payload).get("hook_event_name")
    with tempfile.TemporaryDirectory() as td:
        env=dict(os.environ,XDG_STATE_HOME=td,HERDR_ENV="0"); env.pop("HERDR_PANE_ID",None)
        p=subprocess.run(["python3",HOOK],input=payload,capture_output=True,text=True,env=env,timeout=5)
        files=glob.glob(os.path.join(td,"omarchy","claude-lifecycle","*.json"))
        state=None
        cur=os.path.join(td,"omarchy","claude-lifecycle","current.json")
        if os.path.exists(cur): state=json.load(open(cur))["state"]
        return ev,p.returncode,p.stdout,state
EXPECT={"SessionStart":"idle","UserPromptSubmit":"working","PreToolUse":"working","PostToolUse":"working","PermissionRequest":"blocked",
        "Notification":"blocked","Stop":None,"SubagentStop":None,"SessionEnd":"release"}
def verify(quiet=False):
    fails=[]
    miss=wiring_ok()
    if len(miss)==len(EVENTS): fails.append("wiring: NOT INSTALLED — run `claude-lifecycle install-hooks`")
    elif miss: fails.append(f"wiring: PARTIAL — missing {miss}")
    fx=sorted(glob.glob(os.path.join(HERE,"fixtures","*.json")))
    if not fx: fails.append("fixtures: none captured — run `claude-lifecycle capture` after each Claude Code update")
    for f in fx:
        ev,rc,out,state=run_fixture(f)
        if rc!=0: fails.append(f"{os.path.basename(f)}: exit {rc}")
        if out: fails.append(f"{os.path.basename(f)}: WROTE TO STDOUT ({out[:60]!r}) — contract violation")
        h=json.load(open(f))
        if ev=="Stop":
            if "background_tasks" not in h: fails.append(f"{os.path.basename(f)}: Stop payload lacks background_tasks — Claude Code drift, #3090 fix inoperative")
            exp="working" if h.get("background_tasks") else "idle"
        elif ev=="Notification":
            exp="blocked" if h.get("notification_type") in {"permission_prompt","elicitation_dialog","elicitation_url_dialog","agent_needs_input"} else None
        else: exp=EXPECT.get(ev,"?")
        if exp=="?": continue
        if exp is None and state is not None and ev!="Notification": fails.append(f"{os.path.basename(f)}: {ev} should be ignored, produced {state}")
        elif exp is not None and state!=exp: fails.append(f"{os.path.basename(f)}: {ev} → {state}, expected {exp}")
    cv=stamp_version()
    fv=None
    try: fv=json.load(open(os.path.join(HERE,"fixtures","CAPTURED.json"))).get("claude_version")
    except Exception: pass
    if fv and cv and fv!=cv: fails.append(f"fixtures were captured from {fv!r} but installed claude is {cv!r} — run `claude-lifecycle capture` and re-verify")
    if not quiet:
        print(f"claude installed: {cv or 'not found'}   fixtures captured from: {fv or 'unknown'}")
        print(f"fixtures: {len(fx)}   wiring: {'ok' if not miss else ('not installed' if len(miss)==len(EVENTS) else 'PARTIAL')}")
    if fails:
        print("VERIFY FAILED"); [print("  -",x) for x in fails]; return 1
    print("VERIFY OK"); return 0
def capture():
    """Run a throwaway headless Claude session with ONLY the capture hook, via --settings, and store payloads as fixtures."""
    cap=tempfile.mkdtemp(prefix="cl-capture-"); os.makedirs(os.path.join(HERE,"fixtures"),exist_ok=True)
    hook=os.path.join(HERE,"hooks","capture-payload.sh")
    settings={"hooks":{ev:[{**({} if ev in NO_MATCHER else {"matcher":"*"}),"hooks":[{"type":"command","command":f"bash '{hook}'","timeout":10}]}] for ev in EVENTS}}
    sf=os.path.join(cap,"settings.json"); json.dump(settings,open(sf,"w"))
    env=dict(os.environ,CLAUDE_LIFECYCLE_CAPTURE_DIR=cap)
    for k in ("CLAUDECODE","CLAUDE_CODE_ENTRYPOINT","CLAUDE_CODE_CHILD_SESSION","HERDR_ENV","HERDR_PANE_ID","HERDR_SOCKET_PATH"): env.pop(k,None)
    # HERDR_* scrubbed: --settings MERGES with ~/.claude/settings.json, so an installed herdr SessionStart hook would otherwise claim a real pane for this throwaway session
    RUNS=[("basic",["claude","-p","Reply with exactly: ok","--settings",sf,"--max-turns","1"]),
          ("tool-allowed",["claude","-p","Use the Bash tool to run exactly: echo capture-ok  — then reply done.","--settings",sf,"--max-turns","3","--allowedTools","Bash(echo *)"]),
          ("tool-denied",["claude","-p","Use the Bash tool to run exactly: uname -a  — then reply done.","--settings",sf,"--max-turns","3"])]
    for name,cmd in RUNS:
        try: r=subprocess.run(cmd,capture_output=True,text=True,env=env,timeout=180); print(f"run {name}: exit {r.returncode}: {(r.stdout or r.stderr).strip()[:120]!r}")
        except subprocess.TimeoutExpired: print(f"run {name}: TIMEOUT")
    json.dump({"claude_version":claude_version(),"captured_at":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime()),"host":os.uname().nodename,"platform":sys.platform},
              open(os.path.join(HERE,"fixtures","CAPTURED.json"),"w"),indent=1)
    got=sorted(glob.glob(os.path.join(cap,"*.json"))); got=[g for g in got if not g.endswith("settings.json")]
    kept=[]
    for g in got:
        ev=os.path.basename(g).split(".")[0]; dst=os.path.join(HERE,"fixtures",f"{ev}.json")
        if ev not in kept: shutil.copy(g,dst); kept.append(ev)
    print(f"captured events: {[os.path.basename(g).split('.')[0] for g in got]}"); print(f"new fixtures: {kept}")
    print("NOTE: PermissionRequest/Notification/Elicitation need an interactive session to capture — add them from a real run.")
def run_claude(settings, env, prompt="Reply with exactly: ok"):
    for k in ("CLAUDECODE","CLAUDE_CODE_ENTRYPOINT","CLAUDE_CODE_CHILD_SESSION","HERDR_ENV","HERDR_PANE_ID","HERDR_SOCKET_PATH"): env.pop(k,None)
    # HERDR_* scrubbed: --settings MERGES with ~/.claude/settings.json, so an installed herdr SessionStart hook would otherwise claim a real pane for this throwaway session
    return subprocess.run(["claude","-p",prompt,"--settings",settings,"--max-turns","3","--allowedTools","Bash(echo *)"],capture_output=True,text=True,env=env,timeout=240)
def e2e():
    """Wire the REAL reporter exactly as install-hooks would, into a temp --settings file; run a throwaway claude -p; assert the state file."""
    td=tempfile.mkdtemp(prefix="cl-e2e-"); sf=os.path.join(td,"settings.json"); json.dump({"hooks":hooks_block()},open(sf,"w"))
    env=dict(os.environ,XDG_STATE_HOME=td,CLAUDE_LIFECYCLE_CAPTURE_DIR=os.path.join(td,"raw")); env.pop("HERDR_ENV",None); env.pop("HERDR_PANE_ID",None)
    r=run_claude(sf,env,"Use the Bash tool to run exactly: echo e2e-ok  — then reply done.")
    root=os.path.join(td,"omarchy","claude-lifecycle"); cur=os.path.join(root,"current.json"); fails=[]
    raw=sorted(glob.glob(os.path.join(td,"raw","*.json"))); evs=[]
    for f in raw:
        try: evs.append(json.load(open(f)).get("hook_event_name"))
        except Exception: evs.append("?")
    print(f"claude -p exit {r.returncode}: {(r.stdout or r.stderr).strip()[:80]!r}"); print(f"events reached reporter ({len(evs)}): {evs}")
    if r.returncode!=0: fails.append("claude -p failed")
    for need in ("SessionStart","UserPromptSubmit","PreToolUse","PostToolUse","Stop","SessionEnd"):
        if need not in evs: fails.append(f"{need} never reached the reporter — wiring shape not honoured by this Claude Code")
    if not os.path.exists(cur): fails.append("state file never written")
    else:
        d=json.load(open(cur)); print(f"current.json: state={d['state']} last_event={d['last_event']} claude_version={d.get('claude_version')}")
        if d["last_event"]!="SessionEnd" or d["state"]!="release": fails.append(f"final state {d['state']}/{d['last_event']}, expected release/SessionEnd")
        left=[f for f in glob.glob(os.path.join(root,"*.json")) if not f.endswith("current.json")]
        if left: fails.append(f"session file(s) not released: {[os.path.basename(x) for x in left]}")
    if r.stderr and "hook" in r.stderr.lower(): fails.append(f"hook error on stderr: {r.stderr.strip()[:200]!r}")
    if fails: print("E2E FAILED"); [print("  -",x) for x in fails]; return 1
    print("E2E OK — install-hooks wiring shape is honoured by", claude_version()); return 0
def status():
    cur=os.path.join(STATE_ROOT,"current.json")
    if not os.path.exists(cur): print("no state"); return 0
    d=json.load(open(cur)); print(json.dumps(d,indent=1)); return 0
if __name__=="__main__":
    cmd=(sys.argv[1:] or ["status"])[0]
    {"install-hooks":install_hooks,"uninstall-hooks":uninstall_hooks,"verify":lambda:sys.exit(verify()),
     "capture":capture,"e2e":lambda:sys.exit(e2e()),"status":lambda:sys.exit(status())}.get(cmd,lambda:print("usage: claude-lifecycle install-hooks|uninstall-hooks|verify|capture|e2e|status"))()
